#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

#define M_LEFT MOVE_LEFT
#define M_RIGHT MOVE_RIGHT
#define M_UP MOVE_UP
#define M_DOWN MOVE_DOWN

#define S_LEFT SCRL_LEFT
#define S_RIGHT SCRL_RIGHT
#define S_UP SCRL_UP
#define S_DOWN SCRL_DOWN

#define BASE  0
#define NUM   1
#define FNUM  2
#define SYM   3
#define FUN   4
#define MOUSE 5

#define KR_FUN &lt FUN &key_repeat

#define KEY_REP &mo FUN &key_repeat
#define CAG LC(LA(LGUI))

#define SF_CTRL &kp_sk LCTRL LSFT

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

&sk {
    release-after-ms = <2000>;
    quick-release;
};

/ {
        behaviors {
            sm_shft: smart_shift {
                compatible = "zmk,behavior-mod-morph";
                #binding-cells = <0>;
                bindings = <&sk LSHFT>, <&caps_word>;
                mods = <(MOD_RSFT)>;
            };

            kp_sk: kp_sk {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <200>;
                quick-tap-ms = <200>;
                require-prior-idle-ms = <125>;
                flavor = "tap-preferred";
                bindings = <&kp>, <&sk>;
            };

            mo_sk: mo_sk {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                tapping-term-ms = <200>;
                quick-tap-ms = <200>;
                require-prior-idle-ms = <125>;
                flavor = "tap-preferred";
                bindings = <&mo>, <&sk>;
            };
        };
        keymap {
                compatible = "zmk,keymap";
                base {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &kp Q         &kp W         &kp F         &kp P         &kp G             &kp J         &kp L         &kp U         &kp Y        &kp SQT
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp A         &kp R         &kp S         &kp T         &kp D             &kp H         &kp N         &kp E         &kp I        &kp O
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &kp Z         &kp X         &kp C         &kp V         &kp B             &kp K         &kp M       &kp COMMA      &kp DOT      &kp FSLH
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                              &mo_sk SYM LGUI &lt NUM SPC     &kp CAG          &kp RCTRL  &mo_sk FUN RSFT &mt RALT ESC
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                num {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &none         &none         &none         &none         &none             &none        &kp N7        &kp N8        &kp N9        &kp BSPC   
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSFT       &none             &none        &kp N4        &kp N5        &kp N6        &kp RET    
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &none         &none         &none         &none         &none            &kp N0        &kp N1        &kp N2        &kp N3         &none     
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &none         &none         &none             &none       &mo FNUM        &none
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                fnum {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
  &bt BT_CLR_ALL  &bt BT_CLR       &none         &none         &none            &kp F12       &kp F7        &kp F8        &kp F9        &kp BSPC   
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSFT       &none            &kp F11       &kp F4        &kp F5        &kp F6        &kp RET    
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &kp F10       &kp F1        &kp F2        &kp F3         &none     
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &none         &none         &none             &none         &none         &none
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                sym {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &none       &kp TILDE     &kp STAR      &kp CARET       &none           &kp HASH      &kp DLLR       &kp AT        &none        &kp GRAVE
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
     &kp EXCL      &kp MINUS     &kp PLUS      &kp EQUAL     &kp PRCNT         &kp SEMI      &kp LPAR       &kp RPAR     &kp LBKT      &kp UNDER
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &none         &none       &kp PIPE      &kp AMPS      &kp COLON         &kp COLON     &kp LBRC       &kp RBRC     &kp RBKT      &kp BSLH
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &none         &none         &none           &kp BSPC       &kp SPC        &none
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                fun {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &none     &kp C_BRI_DN  &kp C_BRI_UP  &kp C_VOL_DN  &kp C_VOL_UP          &none       &kp PG_DN     &kp PG_UP       &none         &none     
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSFT       &none            &kp LEFT      &kp DOWN       &kp UP      &kp RIGHT       &none      
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &none         &none         &none         &none         &none             &none        &kp BSPC      &kp RET        &none         &none
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                  &kp TAB      &to MOUSE    &caps_word           &none         &none         &none
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
                mouse {
                        bindings = <
//╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
       &none         &none         &none         &none         &none            &mkp MB4       &none         &none       &mkp MB5      &mkp MB3    
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSFT       &none          &mmv M_LEFT   &mmv M_DOWN    &mmv M_UP    &mmv M_RIGHT     &none      
//├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
       &none         &none         &none         &none         &none          &msc S_LEFT   &msc S_DOWN    &msc S_UP   &msc S_RIGHT     &none     
//╰─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┴─────────────╯
                                   &none       &to BASE        &none             &none       &mkp LCLK     &mkp RCLK    
//                            ╰─────────────┴─────────────┴─────────────╯   ╰─────────────┴─────────────┴─────────────╯
                        >;
                };
        };
};
